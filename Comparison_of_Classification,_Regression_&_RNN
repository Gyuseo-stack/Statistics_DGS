      "cell_type": "code",
      "source": [
        "# R_Score should be minimum so 1st quantile is set as 1.\n",
        "def R_Score(a,b,c):\n",
        "    if a <= c[b][0.25]:\n",
        "        return 1\n",
        "    elif a <= c[b][0.50]:\n",
        "        return 2\n",
        "    elif a <= c[b][0.75]:\n",
        "        return 3\n",
        "    else:\n",
        "        return 4\n",
        "# The higher the F_Score,M_Score the better so 1st quantile is set as 4.\n",
        "def FM_Score(x,y,z):\n",
        "    if x <= z[y][0.25]:\n",
        "        return 4\n",
        "    elif x <= z[y][0.50]:\n",
        "        return 3\n",
        "    elif x <= z[y][0.75]:\n",
        "        return 2\n",
        "    else:\n",
        "        return 1"
      ],
